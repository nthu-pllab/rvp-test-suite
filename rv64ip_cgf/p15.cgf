pm2add.h:
    config:
      - check ISA:=regex(.*I.*P.*Zicsr.*)
    mnemonics:
      pm2add.h: 0
    rs1:
      <<: *all_regs
    rs2:
      <<: *all_regs
    rd:
      <<: *all_regs
    op_comb:
      <<: *rfmt_op_comb
    val_comb:
      abstract_comb:
