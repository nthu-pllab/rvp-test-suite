# Page 9

psrli.b:
    config:
      - check ISA:=regex(.*I.*P.*Zicsr.*)
    mnemonics:
      psrli.b: 0
    rs1:
      <<: *all_regs
    rd:
      <<: *all_regs
    op_comb:
      <<: *ifmt_op_comb
    val_comb:
      abstract_comb:
        'simd_base_val("rs1", xlen, 8, signed=True)': 0
        'simd_imm_val("imm_val", 3)': 0

