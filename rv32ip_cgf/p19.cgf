# Page 19

pwsll.bs:
    config:
      - check ISA:=regex(.*I.*P.*Zicsr.*)
    mnemonics:
      pwsll.bs: 0
    rs1:
      <<: *all_regs
    rs2:
      <<: *all_regs
    rd:
      <<: *pair_regs
    op_comb:
      <<: *ifmt_op_comb
    val_comb:
      abstract_comb:
        'simd_base_val("rs1", xlen, 8, signed=True)': 0
        'simd_base_val("rs2", xlen, 8, signed=True)': 0
        'simd_val_comb(xlen, 8, signed=True)': 0

