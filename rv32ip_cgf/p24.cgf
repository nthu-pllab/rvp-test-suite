# Page 24


ppack.dh:
    config:
      - check ISA:=regex(.*I.*P.*Zicsr.*)
    mnemonics:
      ppack.dh: 0
    rs1:
      <<: *pair_regs
    rs2:
      <<: *pair_regs
    rd:
      <<: *pair_regs
    op_comb:
      <<: *rfmt_op_comb
    val_comb:
      abstract_comb:
        'simd_base_val("rs1", xlen * 2, 16, signed=True)': 0
        'simd_base_val("rs2", xlen * 2, 16, signed=True)': 0

