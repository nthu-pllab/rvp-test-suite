# Page 21

pslli.db:
    config:
      - check ISA:=regex(.*I.*P.*Zicsr.*)
    mnemonics:
      pslli.db: 0
    rs1:
      <<: *pair_regs
    rd:
      <<: *pair_regs
    op_comb:
      <<: *ifmt_op_comb
    val_comb:
      'imm_val == 0': 0
      'imm_val > 0': 0
      'imm_val == ((2**3)-1)': 0
      abstract_comb:
        'simd_base_val("rs1", xlen * 2, 8, signed=True)': 0

