mseq:
    config: 
      - check ISA:=regex(.*I.*P)
    mnemonics: 
      mseq: 0
    rs1: 
      <<: *all_regs
    rs2: 
      <<: *all_regs
    rd:
      <<: *all_regs
    op_comb: 
      <<: *rfmt_op_comb
    val_comb:
      <<: [*base_rs1val_sgn , *base_rs2val_sgn , *rfmt_val_comb_sgn]
      abstract_comb:
        <<: [*rs1val_walking, *rs2val_walking]

mslt:
    config: 
      - check ISA:=regex(.*I.*P)
    mnemonics: 
