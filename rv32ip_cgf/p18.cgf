pli.dh:
    config: 
      - check ISA:=regex(.*I.*P.*Zicsr.*)
    mnemonics: 
      pli.dh: 0
    rd: 
      <<: *all_regs
    val_comb:
        'imm_val == 0': 0
        'imm_val > 0': 0
        'imm_val == ((2**10)-1)': 0
        abstract_comb:
            'sp_dataset(10, ["imm_val"], signed=False)': 0
            'walking_ones("imm_val", 10, False)': 0
            'walking_zeros("imm_val", 10, False)': 0
            'alternate("imm_val", 10, False)': 0

